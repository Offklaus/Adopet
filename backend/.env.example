# Porta da API. O proxy do Vite (frontend/vite.config.js) aponta para ela.
PORT=3333
HOST=localhost

# Conexão com o PostgreSQL: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
# Se a senha tiver caracteres especiais (@ : / # ?), codifique-os: @ vira %40, # vira %23.
DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/adopet

# Banco separado para os testes (npm test apaga e recria os dados dele).
TEST_DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/adopet_test

# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGIN=http://localhost:5173
