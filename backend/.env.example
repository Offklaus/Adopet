# Porta da API. O proxy do Vite (frontend/vite.config.js) aponta para ela.
PORT=3333
HOST=localhost

# Conexão com o PostgreSQL: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
# Se a senha tiver caracteres especiais (@ : / # ?), codifique-os: @ vira %40, # vira %23.
DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/adopet

# Banco separado para os testes (npm test apaga e recria os dados dele).
TEST_DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/adopet_test

# Chave para cadastrar animais (POST /api/pets), enviada como "Authorization: Bearer <chave>".
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vazia, o cadastro fica desligado.
ADMIN_API_KEY=

# "Entrar com o Google": Client ID OAuth (tipo "Aplicativo da Web") do Google Cloud Console.
# Em "Origens JavaScript autorizadas", inclua http://localhost:5173. Vazio, o botão fica desligado.
GOOGLE_CLIENT_ID=

# "true" em produção (HTTPS), para o cookie de login só trafegar por conexão segura.
COOKIE_SECURE=false

# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGIN=http://localhost:5173
